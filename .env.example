# Copy to .env and fill in. Never commit the real thing.

# A THROWAWAY key holding a little Sepolia test ETH. This account pays everybody's gas.
# Never use a key that holds real money. Get test ETH free from:
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
#   https://sepolia-faucet.pk910.de/
RELAYER_KEY=0xyour_throwaway_test_key

# First choice of Sepolia node. If it is blocked or throttled the relayer falls through to a
# built-in list, so this is a preference rather than a hard dependency.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional extra nodes to try first, comma separated.
# RPC_URLS=https://sepolia.drpc.org,https://1rpc.io/sepolia

CHAIN_ID=11155111
EXPLORER=https://sepolia.etherscan.io

# Shared secret used to verify mobile money webhooks. With a real provider this is THEIR
# secret, from their dashboard. Anyone who knows it can credit balances, so treat it like a
# password. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOMO_WEBHOOK_SECRET=change_me_before_going_anywhere_near_real_money
